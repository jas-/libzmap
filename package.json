{
  "name": "libzmap",
  "version": "1.0.0",
  "description": "In-process Node.js bindings for the zmap network scanner",
  "main": "index.js",
  "author": "Jason Gerfen <jason.gerfen@gmail.com>",
  "license": "Apache-2.0",
  "keywords": [
    "zmap",
    "libzmap",
    "network-scanner",
    "scanner",
    "port-scanner",
    "host-discovery",
    "icmp",
    "tcp",
    "udp",
    "syn-scan",
    "network",
    "security",
    "reconnaissance",
    "pcap",
    "native",
    "addon",
    "n-api",
    "napi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jas-/libzmap.git"
  },
  "bugs": {
    "url": "https://github.com/jas-/libzmap/issues"
  },
  "gypfile": true,
  "os": [
    "linux",
    "darwin"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "lib/",
    "binding.gyp",
    "scripts/",
    "src/*.c",
    "src/*.h",
    "src/shim/",
    "src/gen/",
    "src/zmap/src/",
    "src/zmap/lib/",
    "src/zmap/conf/",
    "src/zmap/LICENSE",
    "examples/"
  ],
  "scripts": {
    "install": "node scripts/fetch-zmap.js && node scripts/generate.js && node-gyp rebuild",
    "build": "node scripts/fetch-zmap.js && node scripts/generate.js && node-gyp rebuild -j max",
    "prepack": "node scripts/fetch-zmap.js --check && node scripts/generate.js",
    "test": "node --test test/*.test.js"
  },
  "zmap": {
    "repository": "https://github.com/zmap/zmap",
    "version": "v4.4.0",
    "commit": "651ed713759a12e283c449259b2f6fa027ccf9b5"
  }
}
